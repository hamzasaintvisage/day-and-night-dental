# Day Night Dental — Hostinger (LiteSpeed/Apache) config
# Holds: security headers + caching + custom 404 + "coming soon" holding mode.
# To GO LIVE: delete only the "COMING SOON MODE" block at the bottom. Keep everything else.

# ----------------------------------------------------------------------------
# Security headers (applied to every response, including errors)
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), browsing-topics=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://images.unsplash.com; font-src 'self'; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"

  # Don't disclose the PHP version (X-Powered-By) on any response.
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # HTML must not be cached long, so a go-live (or any edit) is seen immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------------
# Protect the secret config (it's also a .php, so PHP executes it and never serves the
# source — this deny is belt-and-braces). Also block dotfiles.
# ----------------------------------------------------------------------------
<FilesMatch "^_config\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ----------------------------------------------------------------------------
# Caching: hashed build assets + fonts long; unhashed images a week
# ----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType image/webp "access plus 1 week"
</IfModule>

# ----------------------------------------------------------------------------
# Custom 404 (branded page from the React build) — used once live
# ----------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ----------------------------------------------------------------------------
# COMING SOON MODE  ——  DELETE THIS WHOLE BLOCK TO GO LIVE
# Serves coming-soon.html for every page request (URL stays the same), while
# still letting static assets, fonts, the API and the holding page itself load.
# ----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/coming-soon\.html$
  # Private preview gate: holders of the secret cookie (set by /preview.php) see the real
  # WIP site; everyone else still gets coming-soon. Remove these 2 lines + preview.php at go-live.
  RewriteCond %{REQUEST_URI} !^/preview\.php$
  RewriteCond %{HTTP_COOKIE} !(^|;\s)dnd_preview=13ae86f0eda921dae9d1eff6cb36bdf9(;|$)
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/(assets|fonts)/
  RewriteCond %{REQUEST_URI} !\.(png|jpe?g|gif|svg|webp|ico|woff2?|css|js|map|webmanifest|xml|txt)$
  RewriteRule ^ /coming-soon.html [L]
</IfModule>
# ----------------------------------------------------------------------------
# END COMING SOON MODE
# ----------------------------------------------------------------------------

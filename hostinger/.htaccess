# Day Night Dental — Hostinger (LiteSpeed/Apache) config
# Holds: security headers + caching + custom 404 + canonical (www -> apex) redirect.
# LIVE: the coming-soon holding gate has been removed.

# ----------------------------------------------------------------------------
# Security headers (applied to every response, including errors)
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), browsing-topics=()"
  # HSTS without includeSubDomains/preload: those would commit every subdomain (mail, cpanel,
  # webmail, ftp) to HTTPS-only for 2 years and require preload-list submission. Add them
  # deliberately later, only once every subdomain is confirmed to serve valid HTTPS.
  Header always set Strict-Transport-Security "max-age=63072000"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  # Analytics domains (GA4 + Meta Pixel) are pre-allowed so enabling the IDs in config.js
  # "just works" instead of being silently blocked by CSP. They load nothing until the owner
  # sets the IDs and the visitor grants consent.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://images.unsplash.com https://www.googletagmanager.com https://www.google-analytics.com https://www.facebook.com; font-src 'self'; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com https://connect.facebook.net https://www.facebook.com; frame-src https://www.google.com https://maps.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"

  # Don't disclose the PHP version (X-Powered-By) on any response.
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # HTML must not be cached long, so a go-live (or any edit) is seen immediately.
  # "always set" so it wins over any upstream no-store (which would force a full
  # re-download instead of a cheap 304 revalidation).
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Content-hashed build assets (app-XXXX.js / .css) + self-hosted fonts are immutable
  # for a given URL — cache them hard so repeat visits are instant. "always set" forces
  # this over any server/gate-era no-store header that was killing browser caching.
  <FilesMatch "\.(css|js|mjs|woff2)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images aren't content-hashed, so a month (still avoids the every-visit re-download).
  <FilesMatch "\.(webp|png|jpe?g|svg|ico|avif)$">
    Header always set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------------
# Protect the secret config (it's also a .php, so PHP executes it and never serves the
# source — this deny is belt-and-braces). Also block dotfiles.
# ----------------------------------------------------------------------------
<FilesMatch "^_config\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Belt-and-braces across the WHOLE document root (covers /cron, /assets, /fonts and any
# subdir without its own rules): never serve data/log/backup files, never list a directory.
<FilesMatch "\.(ndjson|log|env|bak|sql)$">
  Require all denied
</FilesMatch>
Options -Indexes

# ----------------------------------------------------------------------------
# Caching: hashed build assets + fonts long; unhashed images a week
# ----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType image/webp "access plus 1 week"
</IfModule>

# ----------------------------------------------------------------------------
# Custom 404 (branded page from the React build) — used once live
# ----------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ----------------------------------------------------------------------------
# Canonical host: force apex (no www). 301 www -> apex. PERMANENT — keep after go-live.
# ----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS first: covers first-time/bookmarked plain-http hits (HSTS only protects clients
  # who already visited over https; upgrade-insecure-requests doesn't cover top-level navigation).
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Canonical host: force apex (no www).
  RewriteCond %{HTTP_HOST} ^www\.daynightdental\.co\.uk$ [NC]
  RewriteRule ^ https://daynightdental.co.uk%{REQUEST_URI} [L,R=301]
</IfModule>


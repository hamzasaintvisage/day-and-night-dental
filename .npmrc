legacy-peer-deps=true
# Enforce the Node engine floor (package.json engines >=20.19, .nvmrc 20.19.0) on install, so a
# machine on an unsupported Node fails fast at `npm install`/`npm ci` instead of silently building
# against a runtime Vite 7 doesn't support. (Does not affect `npm run build`/deploy.)
engine-strict=true
# NOTE on the esbuild override in package.json: Vite 7's declared esbuild ^0.27 resolves to 0.27.x,
# which is in the vulnerable range (GHSA-gv7w-rqvm-qjhr / GHSA-g7r4-m6w7-qqqr, dev-server only,
# fixed in 0.28.1). The "overrides": { "esbuild": "0.28.1" } keeps `npm audit` clean while staying
# on Vite 7. Do not remove it without re-checking `npm audit`.
